# =============================================================================
# CorridorKey 2.0 Desktop — Git Ignore Specification
# =============================================================================

# Operating System & Filesystem Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/

# Node.js & Frontend Bundles
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
apps/desktop/dist/
apps/desktop/.vite/

# Rust & Tauri Builds
target/
apps/desktop/src-tauri/target/
/tmp/corridorkey-target/
*.pdb

# Pretrained Model Weights & Large Checkpoints
# (Under CorridorKey Licence & publisher terms, weights are fetched on demand)
vendor/CorridorKey2.0/weights/*.safetensors
vendor/CorridorKey2.0/vfms/cradio/*
!vendor/CorridorKey2.0/vfms/cradio/.gitkeep
vendor/CorridorKey2.0/vfms/moge/*
!vendor/CorridorKey2.0/vfms/moge/.gitkeep
vendor/CorridorKey2.0/vfms/rvm/*
!vendor/CorridorKey2.0/vfms/rvm/.gitkeep
models/
*.safetensors
*.pt
*.npz
*.tar.zst
*.part

# Application Logs, Backups & Crash Recovery
*.log
logs/
.ck_backups/
.first_run_done
corridorkey_diagnostic_report_*.json

# Render Outputs & Video Scratch Files
output/
exports/
*.mov
*.mp4
*.exr

# IDEs & Editor Metadata
.idea/
.vscode/
*.swp
*.swo
*~

# Enforce AppleDouble and macOS metadata ignore everywhere
**/._*
**/.DS_Store
