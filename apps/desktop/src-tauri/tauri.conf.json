{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "CorridorKey 2.0",
  "version": "2.0.0",
  "identifier": "com.corridorkey.desktop",
  "build": {
    "beforeDevCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CorridorKey 2.0 Desktop",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 CorridorKey 2.0 Desktop Contributors. Licensed under Corridor Key Licence v2.0.",
    "category": "Video",
    "shortDescription": "Professional AI Video Keying & Rotoscoping Desktop Application",
    "longDescription": "CorridorKey 2.0 Desktop is a native standalone desktop application for AI-powered video keying, rotoscoping, multi-track timeline editing, and professional VFX compositing.",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "12.0",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["en-US"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    },
    "fileAssociations": [
      {
        "ext": ["ckproj"],
        "name": "CorridorKey Project",
        "description": "CorridorKey 2.0 Desktop Project File",
        "role": "Editor",
        "mimeType": "application/x-corridorkey-project"
      }
    ]
  }
}
